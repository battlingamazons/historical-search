{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Historical Society Search",
  "version": "0.3.0",
  "identifier": "org.historicalsocietysearch.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Historical Society Search",
        "width": 1000,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "ocr/": "ocr/"
    },
    "linux": {
      "deb": {
        "depends": [
          "tesseract-ocr"
        ]
      }
    }
  }
}
